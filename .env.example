# ==============================================================================
# MediAI System Environment Configuration Template
# Spring Boot + MySQL + HTML5/CSS3/Vanilla JS Unified Architecture
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mediai?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=YOUR_MYSQL_PASSWORD

# Google Gemini API Key (Server-Side Only for AI Decision-Support Risk Prediction)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# JWT Secret for Staff Authentication Tokens (Minimum 32 characters)
JWT_SECRET=MediAiSecretKeyForClinicalStaffAuthTokensMustBeAtLeast32BytesLong
JWT_EXPIRATION=86400000

# Encryption Key for PHI (32-byte hex string)
PHI_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
